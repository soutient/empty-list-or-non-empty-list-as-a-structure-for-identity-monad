cabal-version:  2.2
name:           ListAppearsAsRecursiveMultipointedStructure
version:        0.1.0.0
synopsis:       Empty list or non empty list
license:        BSD-2-Clause
license-file:   LICENSE
author:         Alexis Soutient
category:       Researchig of monads
build-type:     Simple

executable cql-compiler
    main-is:          Main.hs
    other-modules:    Domain
                    , Compiler
    build-depends:    base >= 4.14 && < 5
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall

source-repository head
  type:     git
  location: https://github.com/soutient/cql-path-to-sql-compiler

extra-source-files:
    README.md
    CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/soutient/ListAppearsAsRecursiveMultipointedStructure

library
  exposed-modules:
      Lib
  other-modules:
      Paths_ListAppearsAsRecursiveMultipointedStructure
  autogen-modules:
      Paths_ListAppearsAsRecursiveMultipointedStructure
  hs-source-dirs:
      src
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints
  build-depends:
      base >=4.7 && <5
  default-language: Haskell2010

executable ListAppearsAsRecursiveMultipointedStructure-exe
  main-is: Main.hs
  other-modules:
      Paths_ListAppearsAsRecursiveMultipointedStructure
  autogen-modules:
      Paths_ListAppearsAsRecursiveMultipointedStructure
  hs-source-dirs:
      app
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      ListAppearsAsRecursiveMultipointedStructure
    , base >=4.7 && <5
  default-language: Haskell2010

test-suite ListAppearsAsRecursiveMultipointedStructure-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  other-modules:
      Paths_ListAppearsAsRecursiveMultipointedStructure
  autogen-modules:
      Paths_ListAppearsAsRecursiveMultipointedStructure
  hs-source-dirs:
      test
  ghc-options: -Wall -Wcompat -Widentities -Wincomplete-record-updates -Wincomplete-uni-patterns -Wmissing-export-lists -Wmissing-home-modules -Wpartial-fields -Wredundant-constraints -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      ListAppearsAsRecursiveMultipointedStructure
    , base >=4.7 && <5
  default-language: Haskell2010
